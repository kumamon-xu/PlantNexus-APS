{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plantnexus:aps:schema:import-package:v2",
  "title": "PlantNexus APS Standard Import Package v2",
  "description": "Strict canonical import envelope. Source mapping remains adapter-owned and every normalization/canonicalization version is explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "import_package_version",
    "schema_set_version",
    "package_id",
    "source_versions",
    "normalization_rule_version",
    "canonicalization_version",
    "synthetic",
    "records"
  ],
  "properties": {
    "import_package_version": {
      "const": "import-package.v2"
    },
    "schema_set_version": {
      "const": "2.0.0"
    },
    "package_id": {
      "$ref": "#/$defs/canonicalId"
    },
    "source_versions": {
      "$ref": "#/$defs/sourceVersions"
    },
    "normalization_rule_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "canonicalization_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "synthetic": {
      "type": "boolean"
    },
    "synthetic_provenance": {
      "$ref": "#/$defs/syntheticProvenance"
    },
    "records": {
      "$ref": "urn:plantnexus:aps:schema:canonical-records:v1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": true
          }
        },
        "required": ["synthetic"]
      },
      "then": {
        "required": ["synthetic_provenance"]
      },
      "else": {
        "not": {
          "required": ["synthetic_provenance"]
        }
      }
    }
  ],
  "$defs": {
    "canonicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sourceVersions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/canonicalId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "syntheticProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_version",
        "seed",
        "factory_profile_id",
        "profile_version",
        "generator_id",
        "generator_version"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "scenario_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "factory_profile_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "profile_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "generator_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "generator_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    }
  }
}
