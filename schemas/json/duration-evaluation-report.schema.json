{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plantnexus:aps:schema:duration-evaluation-report:v1",
  "title": "PlantNexus APS Duration Evaluation Report v1",
  "description": "Immutable offline Simulation evaluation measurements with exact model, dataset, split, feature and baseline lineage. P6-02 does not make a promotion or runtime gate decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "duration_evaluation_report_version", "schema_set_version", "canonicalization_version",
    "evaluation_report_id", "model_reference", "dataset_manifest", "split_manifest",
    "feature_schema_version", "standard_duration_baseline", "evaluation_code",
    "evaluated_at_utc", "evaluation_data_cutoff_utc", "metrics", "slices",
    "gate_assessment", "privacy_review_reference", "data_plane", "environment",
    "synthetic", "synthetic_provenance", "production_binding", "governance_boundary",
    "evaluation_report_fingerprint"
  ],
  "properties": {
    "duration_evaluation_report_version": {"const": "duration-evaluation-report.v1"},
    "schema_set_version": {"const": "2.9.0"},
    "canonicalization_version": {"const": "canonical-json.v1"},
    "evaluation_report_id": {"type": "string", "pattern": "^duration-evaluation-report-[0-9a-f]{64}$"},
    "model_reference": {"$ref": "#/$defs/modelReference"},
    "dataset_manifest": {"$ref": "#/$defs/artifactReference"},
    "split_manifest": {"$ref": "#/$defs/artifactReference"},
    "feature_schema_version": {"const": "duration-features.v1"},
    "standard_duration_baseline": {"$ref": "#/$defs/artifactReference"},
    "evaluation_code": {"$ref": "#/$defs/codeReference"},
    "evaluated_at_utc": {"$ref": "#/$defs/utcInstant"},
    "evaluation_data_cutoff_utc": {"$ref": "#/$defs/utcInstant"},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/metric"}},
    "slices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slice"}},
    "gate_assessment": {"$ref": "#/$defs/gateAssessment"},
    "privacy_review_reference": {"$ref": "#/$defs/artifactReference"},
    "data_plane": {"const": "SIMULATION"},
    "environment": {"enum": ["DEVELOPMENT", "TEST", "BENCHMARK"]},
    "synthetic": {"const": true},
    "synthetic_provenance": {"$ref": "#/$defs/syntheticProvenance"},
    "production_binding": {"const": false},
    "governance_boundary": {"$ref": "#/$defs/governanceBoundary"},
    "evaluation_report_fingerprint": {"$ref": "#/$defs/sha256Fingerprint"}
  },
  "$defs": {
    "canonicalId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$"},
    "sha256Fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utcInstant": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "semanticVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "artifactReference": {
      "type": "object", "additionalProperties": false,
      "required": ["document_version", "artifact_id", "fingerprint"],
      "properties": {
        "document_version": {"$ref": "#/$defs/canonicalId"},
        "artifact_id": {"$ref": "#/$defs/canonicalId"},
        "fingerprint": {"$ref": "#/$defs/sha256Fingerprint"}
      }
    },
    "modelReference": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_model_manifest_version", "model_manifest_id", "model_manifest_fingerprint", "model_version", "model_artifact_digest"],
      "properties": {
        "duration_model_manifest_version": {"const": "duration-model-manifest.v1"},
        "model_manifest_id": {"$ref": "#/$defs/canonicalId"},
        "model_manifest_fingerprint": {"$ref": "#/$defs/sha256Fingerprint"},
        "model_version": {"$ref": "#/$defs/semanticVersion"},
        "model_artifact_digest": {"$ref": "#/$defs/sha256Fingerprint"}
      }
    },
    "codeReference": {
      "type": "object", "additionalProperties": false,
      "required": ["code_revision", "dependency_lock_digest", "configuration"],
      "properties": {
        "code_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dependency_lock_digest": {"$ref": "#/$defs/sha256Fingerprint"},
        "configuration": {"$ref": "#/$defs/artifactReference"}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_name", "value", "unit", "direction", "sample_count"],
      "properties": {
        "metric_name": {"enum": ["MAE_SECONDS", "P50_ABSOLUTE_ERROR_SECONDS", "P90_COVERAGE_RATIO", "STANDARD_DURATION_MAE_SECONDS"]},
        "value": {"type": "number", "minimum": 0},
        "unit": {"enum": ["SECONDS", "RATIO"]},
        "direction": {"enum": ["LOWER_IS_BETTER", "HIGHER_IS_BETTER"]},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "slice": {
      "type": "object", "additionalProperties": false,
      "required": ["slice_key", "slice_value", "sample_count", "metrics"],
      "properties": {
        "slice_key": {"enum": ["FACTORY_ID", "OPERATION_TYPE_ID", "RESOURCE_ID"]},
        "slice_value": {"$ref": "#/$defs/canonicalId"},
        "sample_count": {"type": "integer", "minimum": 1},
        "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/metric"}}
      }
    },
    "gateAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_contract", "decision", "thresholds_embedded"],
      "properties": {
        "gate_contract": {"const": "duration-evaluation-gate.planned-p6-05"},
        "decision": {"const": "NOT_EVALUATED_BY_P6_02"},
        "thresholds_embedded": {"const": false}
      }
    },
    "syntheticProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["assumption_profile", "assumption_refs"],
      "properties": {
        "assumption_profile": {"const": "SIM-P6-DURATION-CONTRACT-001@1.0.0"},
        "assumption_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SIM-ASSUMPTION-[0-9]{3}$"}, "contains": {"const": "SIM-ASSUMPTION-021"}}
      }
    },
    "governanceBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["production_authorized", "open_authority_gaps"],
      "properties": {
        "production_authorized": {"const": false},
        "open_authority_gaps": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["OPEN-010", "OPEN-011", "OPEN-014", "OPEN-015"]}}
      }
    }
  }
}
