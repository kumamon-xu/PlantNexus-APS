{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plantnexus:aps:schema:export-manifest:v3",
  "title": "PlantNexus APS P4 Dynamic Replan Export Manifest v3",
  "description": "Simulation-internal additive P4 package manifest binding a verified P3 package and complete ChangeReport.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id", "manifest_fingerprint", "export_manifest_version",
    "schema_set_version", "package_profile", "canonicalization_version",
    "csv_dialect_version", "xlsx_profile_version", "generated_at_utc",
    "publishable", "target", "schedule_version", "publication", "export_job",
    "audit_lineage", "p3_package", "change_report", "entity_counts",
    "file_count", "files", "deferred_artifacts", "state_boundary",
    "synthetic", "synthetic_provenance"
  ],
  "properties": {
    "package_id": {"type": "string", "pattern": "^export-package-[0-9a-f]{64}$"},
    "manifest_fingerprint": {"$ref": "urn:plantnexus:aps:schema:execution-event:v1#/$defs/sha256Fingerprint"},
    "export_manifest_version": {"const": "export-manifest.v3"},
    "schema_set_version": {"const": "2.8.0"},
    "package_profile": {"const": "p4-dynamic-replan-export.v1"},
    "canonicalization_version": {"const": "canonical-json.v1"},
    "csv_dialect_version": {"const": "rfc4180-lf.v1"},
    "xlsx_profile_version": {"const": "xlsx-safe-deterministic.v1"},
    "generated_at_utc": {"$ref": "urn:plantnexus:aps:schema:execution-event:v1#/$defs/utcInstant"},
    "publishable": {"const": false},
    "target": {"const": "SIMULATION_INTERNAL"},
    "schedule_version": {"$ref": "#/$defs/publishedP4Version"},
    "publication": {"$ref": "urn:plantnexus:aps:schema:export-manifest:v2#/$defs/publicationReference"},
    "export_job": {"$ref": "#/$defs/exportJobReference"},
    "audit_lineage": {"$ref": "urn:plantnexus:aps:schema:export-manifest:v2#/$defs/auditLineage"},
    "p3_package": {"$ref": "#/$defs/p3PackageReference"},
    "change_report": {"$ref": "urn:plantnexus:aps:schema:change-report:v1#/$defs/reportReference"},
    "entity_counts": {"$ref": "#/$defs/entityCounts"},
    "file_count": {"const": 13},
    "files": {"type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true, "items": {"$ref": "#/$defs/fileRecord"}},
    "deferred_artifacts": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "prefixItems": [{"type": "object", "additionalProperties": false, "required": ["path", "status"], "properties": {"path": {"const": "benchmark_report.json"}, "status": {"const": "NOT_APPLICABLE_STANDARD_EXPORT"}}}],
      "items": false
    },
    "state_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["schedule_version", "publication", "export_job_at_materialization", "external_transfer", "production"],
      "properties": {"schedule_version": {"const": "PUBLISHED"}, "publication": {"const": "COMPLETED"}, "export_job_at_materialization": {"const": "EXPORTING"}, "external_transfer": {"const": "NOT_STARTED"}, "production": {"const": "NOT_AUTHORIZED"}}
    },
    "synthetic": {"const": true},
    "synthetic_provenance": {"$ref": "urn:plantnexus:aps:schema:execution-event:v1#/$defs/syntheticProvenance"}
  },
  "$defs": {
    "publishedP4Version": {
      "type": "object", "additionalProperties": false,
      "required": ["schedule_version_version", "schedule_version_id", "state", "content_fingerprint"],
      "properties": {
        "schedule_version_version": {"const": "schedule-version.v2"},
        "schedule_version_id": {"$ref": "urn:plantnexus:aps:schema:execution-event:v1#/$defs/canonicalId"},
        "state": {"const": "PUBLISHED"},
        "content_fingerprint": {"$ref": "urn:plantnexus:aps:schema:execution-event:v1#/$defs/sha256Fingerprint"}
      }
    },
    "exportJobReference": {
      "type": "object", "additionalProperties": false,
      "required": ["export_job_version", "export_job_id", "attempt", "state_at_materialization"],
      "properties": {
        "export_job_version": {"const": "export-job.v3"},
        "export_job_id": {"$ref": "urn:plantnexus:aps:schema:execution-event:v1#/$defs/canonicalId"},
        "attempt": {"type": "integer", "minimum": 1},
        "state_at_materialization": {"const": "EXPORTING"}
      }
    },
    "p3PackageReference": {
      "type": "object", "additionalProperties": false,
      "required": ["export_manifest_version", "package_profile", "package_id", "manifest_fingerprint"],
      "properties": {
        "export_manifest_version": {"const": "export-manifest.v2"},
        "package_profile": {"const": "p3-standard-export.v1"},
        "package_id": {"type": "string", "pattern": "^export-package-[0-9a-f]{64}$"},
        "manifest_fingerprint": {"$ref": "urn:plantnexus:aps:schema:execution-event:v1#/$defs/sha256Fingerprint"}
      }
    },
    "entityCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_operation_count", "problem_operation_count", "assignment_count", "change_operation_count", "demand_count", "resource_count"],
      "properties": {
        "snapshot_operation_count": {"type": "integer", "minimum": 0},
        "problem_operation_count": {"type": "integer", "minimum": 0},
        "assignment_count": {"type": "integer", "minimum": 0},
        "change_operation_count": {"type": "integer", "minimum": 0},
        "demand_count": {"type": "integer", "minimum": 0},
        "resource_count": {"type": "integer", "minimum": 0}
      }
    },
    "fileRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "media_type", "sha256", "size_bytes", "row_count", "sheet_count"],
      "properties": {
        "path": {"enum": ["change_report.json", "import_quality_report.json", "kpi.json", "order_summary.csv", "planning_solution.json", "publication_result.json", "resource_load.csv", "scenario_manifest.json", "schedule_operations.csv", "schedule_version.json", "solver_report.json", "standard_package.xlsx", "validation_report.json"]},
        "role": {"enum": ["CHANGE_REPORT", "IMPORT_QUALITY_REPORT", "KPI", "ORDER_SUMMARY", "VALIDATED_PLANNING_SOLUTION", "PUBLICATION_RESULT", "RESOURCE_LOAD", "P2_CORRECTNESS_SCENARIO_MANIFEST", "SCHEDULE_OPERATIONS", "PUBLISHED_SCHEDULE_VERSION", "SOLVER_REPORT", "STANDARD_WORKBOOK", "VALIDATION_REPORT"]},
        "media_type": {"enum": ["application/json", "text/csv; charset=utf-8", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]},
        "sha256": {"$ref": "urn:plantnexus:aps:schema:execution-event:v1#/$defs/sha256Fingerprint"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "sheet_count": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
