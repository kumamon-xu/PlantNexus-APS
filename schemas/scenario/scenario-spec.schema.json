{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plantnexus:aps:schema:scenario-spec:v1",
  "title": "PlantNexus APS ScenarioSpec v1",
  "description": "A replayable synthetic planning experiment; expected results are contracts, not evidence that a Solver ran.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_contract_version",
    "scenario_id",
    "scenario_version",
    "synthetic_only",
    "factory_profile",
    "generator",
    "seed",
    "required_capabilities",
    "complexity",
    "expected_behavior"
  ],
  "properties": {
    "scenario_contract_version": {
      "const": "scenario-spec.v1"
    },
    "scenario_id": {
      "$ref": "#/$defs/canonicalId"
    },
    "scenario_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "synthetic_only": {
      "const": true
    },
    "factory_profile": {
      "$ref": "#/$defs/factoryProfileReference"
    },
    "generator": {
      "$ref": "#/$defs/generatorReference"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factory_size",
        "routing_complexity",
        "candidate_resource_density",
        "bottleneck_level",
        "due_date_pressure",
        "calendar_fragmentation",
        "material_delay_ratio",
        "wip_ratio",
        "lock_ratio",
        "cross_workshop_ratio",
        "failure_frequency"
      ],
      "properties": {
        "factory_size": {
          "enum": ["XS", "S", "M", "L", "XL"]
        },
        "routing_complexity": {
          "$ref": "#/$defs/level"
        },
        "candidate_resource_density": {
          "enum": ["sparse", "medium", "dense"]
        },
        "bottleneck_level": {
          "$ref": "#/$defs/level"
        },
        "due_date_pressure": {
          "$ref": "#/$defs/level"
        },
        "calendar_fragmentation": {
          "$ref": "#/$defs/level"
        },
        "material_delay_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "wip_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "lock_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "cross_workshop_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "failure_frequency": {
          "enum": ["none", "low", "medium", "high"]
        }
      }
    },
    "expected_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_results"],
      "properties": {
        "allowed_results": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "OPTIMAL",
              "FEASIBLE",
              "INFEASIBLE",
              "NO_SOLUTION_WITHIN_LIMIT",
              "MODEL_INVALID",
              "DATA_REJECTED",
              "VALIDATION_FAILED",
              "CANCELLED",
              "FAILED",
              "UNSUPPORTED_CAPABILITY"
            ]
          }
        },
        "validator_status": {
          "enum": ["PASS", "FAIL"]
        }
      }
    }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "factoryProfileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version"],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "profile_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "generatorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_id", "generator_version"],
      "properties": {
        "generator_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "generator_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "level": {
      "enum": ["low", "medium", "high"]
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "capability": {
      "enum": [
        "SINGLE_FACTORY_MULTI_WORKSHOP",
        "DAG_ROUTING",
        "ALTERNATIVE_RESOURCE",
        "MACHINE_CALENDAR",
        "RELEASE_AND_MATERIAL_GATE",
        "RUNNING_OPERATION",
        "HARD_SOFT_LOCK",
        "APPROVAL_AND_PUBLICATION",
        "DYNAMIC_REPLANNING",
        "SECONDARY_CAPACITY",
        "SEQUENCE_DEPENDENT_SETUP",
        "BATCH_PROCESSING",
        "SPLIT_MERGE",
        "MATERIAL_COMPETITION",
        "PREEMPTIVE_OPERATION",
        "BUFFER_CAPACITY",
        "ALTERNATIVE_MATERIAL",
        "MULTI_FACTORY",
        "AI_DURATION_PREDICTION",
        "REALITY_CALIBRATION"
      ]
    }
  }
}
