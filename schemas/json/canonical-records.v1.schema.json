{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plantnexus:aps:schema:canonical-records:v1",
  "title": "PlantNexus APS Canonical Records v1",
  "description": "Authority-neutral canonical APS entity collections. Source mappings and production values remain external, versioned inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_records_version",
    "factories",
    "workshops",
    "production_lines",
    "resource_groups",
    "resources",
    "calendars",
    "products",
    "routing_versions",
    "routing_operations",
    "routing_precedence_edges",
    "routing_resource_options",
    "demand_orders",
    "production_orders",
    "production_lots",
    "execution_facts",
    "operation_locks"
  ],
  "properties": {
    "canonical_records_version": {
      "const": "canonical-records.v1"
    },
    "factories": {
      "$ref": "#/$defs/factoryCollection"
    },
    "workshops": {
      "$ref": "#/$defs/workshopCollection"
    },
    "production_lines": {
      "$ref": "#/$defs/productionLineCollection"
    },
    "resource_groups": {
      "$ref": "#/$defs/resourceGroupCollection"
    },
    "resources": {
      "$ref": "#/$defs/resourceCollection"
    },
    "calendars": {
      "$ref": "#/$defs/calendarCollection"
    },
    "products": {
      "$ref": "#/$defs/productCollection"
    },
    "routing_versions": {
      "$ref": "#/$defs/routingVersionCollection"
    },
    "routing_operations": {
      "$ref": "#/$defs/routingOperationCollection"
    },
    "routing_precedence_edges": {
      "$ref": "#/$defs/routingPrecedenceEdgeCollection"
    },
    "routing_resource_options": {
      "$ref": "#/$defs/routingResourceOptionCollection"
    },
    "demand_orders": {
      "$ref": "#/$defs/demandOrderCollection"
    },
    "production_orders": {
      "$ref": "#/$defs/productionOrderCollection"
    },
    "production_lots": {
      "$ref": "#/$defs/productionLotCollection"
    },
    "execution_facts": {
      "$ref": "#/$defs/executionFactCollection"
    },
    "operation_locks": {
      "$ref": "#/$defs/operationLockCollection"
    }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "utcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "positiveQuantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_system", "source_version", "source_record_id"],
      "properties": {
        "source_system": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_record_id": {
          "$ref": "#/$defs/canonicalId"
        }
      }
    },
    "unavailableInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_id", "start_at_utc", "end_at_utc", "reason"],
      "properties": {
        "interval_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "start_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "end_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factory_id", "factory_code", "factory_timezone", "source"],
      "properties": {
        "factory_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "factory_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "factory_timezone": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "workshop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workshop_id", "workshop_code", "factory_id", "source"],
      "properties": {
        "workshop_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "workshop_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "factory_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "productionLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_line_id", "production_line_code", "workshop_id", "source"],
      "properties": {
        "production_line_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "production_line_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "workshop_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "resourceGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_group_id", "resource_group_code", "production_line_id", "source"],
      "properties": {
        "resource_group_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "resource_group_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "production_line_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "resource_code",
        "resource_type",
        "status",
        "resource_group_id",
        "calendar_id",
        "capabilities",
        "source"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "resource_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resource_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resource_group_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "calendar_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar_id", "timezone", "unavailable_intervals", "source"],
      "properties": {
        "calendar_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "timezone": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "unavailable_intervals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/unavailableInterval"
          }
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "product_code", "quantity_unit", "source"],
      "properties": {
        "product_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "product_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "quantity_unit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "routingVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing_version_id", "routing_code", "version", "product_id", "source"],
      "properties": {
        "routing_version_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "routing_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "product_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "routingOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing_operation_id",
        "routing_version_id",
        "operation_code",
        "required_capabilities",
        "source"
      ],
      "properties": {
        "routing_operation_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "routing_version_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "operation_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "routingPrecedenceEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing_precedence_edge_id",
        "routing_version_id",
        "predecessor_routing_operation_id",
        "successor_routing_operation_id",
        "min_lag_seconds",
        "transport_lag_seconds",
        "source"
      ],
      "properties": {
        "routing_precedence_edge_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "routing_version_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "predecessor_routing_operation_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "successor_routing_operation_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "min_lag_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_lag_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "transport_lag_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "routingResourceOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing_resource_option_id",
        "routing_operation_id",
        "resource_id",
        "quantity_unit",
        "setup_seconds",
        "cycle_seconds_per_unit",
        "final_duration_seconds",
        "duration_source",
        "duration_source_version",
        "source"
      ],
      "properties": {
        "routing_resource_option_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "routing_operation_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "resource_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "quantity_unit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "setup_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "cycle_seconds_per_unit": {
          "type": "integer",
          "minimum": 0
        },
        "final_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "duration_source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "duration_source_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "demandOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demand_order_id",
        "product_id",
        "quantity",
        "quantity_unit",
        "due_at_utc",
        "source"
      ],
      "properties": {
        "demand_order_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "product_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "quantity": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "quantity_unit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "due_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "productionOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_order_id",
        "demand_order_id",
        "routing_version_id",
        "quantity",
        "quantity_unit",
        "release_at_utc",
        "material_ready_at_utc",
        "source"
      ],
      "properties": {
        "production_order_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "demand_order_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "routing_version_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "quantity": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "quantity_unit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "release_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "material_ready_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "productionLot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_lot_id", "production_order_id", "quantity", "quantity_unit", "source"],
      "properties": {
        "production_lot_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "production_order_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "quantity": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "quantity_unit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "executionFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_fact_id",
        "production_lot_id",
        "routing_operation_id",
        "status",
        "observed_at_utc",
        "quantity_unit",
        "source"
      ],
      "properties": {
        "execution_fact_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "production_lot_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "routing_operation_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "status": {
          "enum": ["RUNNING", "COMPLETED"]
        },
        "observed_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "resource_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "actual_start_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "actual_end_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "completed_quantity": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "remaining_quantity": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "quantity_unit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "remaining_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "RUNNING"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["resource_id", "actual_start_at_utc", "remaining_quantity", "remaining_seconds"],
            "not": {
              "anyOf": [
                {"required": ["actual_end_at_utc"]},
                {"required": ["completed_quantity"]}
              ]
            }
          },
          "else": {
            "required": ["resource_id", "actual_start_at_utc", "actual_end_at_utc", "completed_quantity"],
            "not": {
              "anyOf": [
                {"required": ["remaining_quantity"]},
                {"required": ["remaining_seconds"]}
              ]
            }
          }
        }
      ]
    },
    "operationLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_id",
        "production_lot_id",
        "routing_operation_id",
        "lock_type",
        "resource_id",
        "start_at_utc",
        "end_at_utc",
        "source"
      ],
      "properties": {
        "lock_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "production_lot_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "routing_operation_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "lock_type": {
          "enum": ["HARD_LOCK", "SOFT_LOCK"]
        },
        "resource_id": {
          "$ref": "#/$defs/canonicalId"
        },
        "start_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "end_at_utc": {
          "$ref": "#/$defs/utcInstant"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "factoryCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/factory"}
    },
    "workshopCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/workshop"}
    },
    "productionLineCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/productionLine"}
    },
    "resourceGroupCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/resourceGroup"}
    },
    "resourceCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/resource"}
    },
    "calendarCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/calendar"}
    },
    "productCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/product"}
    },
    "routingVersionCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/routingVersion"}
    },
    "routingOperationCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/routingOperation"}
    },
    "routingPrecedenceEdgeCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/routingPrecedenceEdge"}
    },
    "routingResourceOptionCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/routingResourceOption"}
    },
    "demandOrderCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/demandOrder"}
    },
    "productionOrderCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/productionOrder"}
    },
    "productionLotCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/productionLot"}
    },
    "executionFactCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/executionFact"}
    },
    "operationLockCollection": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/operationLock"}
    }
  }
}
