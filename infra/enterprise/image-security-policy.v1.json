      "aliases": [
        "CVE-2025-62727",
        "PYSEC-2026-1942"
      ],
      "status": "NOT_AFFECTED",
      "justification": "Runtime exposes no FileResponse or StaticFiles path; the Headless API returns bounded JSON responses only.",
      "source_guards": [
        "FileResponse",
        "StaticFiles"
      ]
    },
    {
      "advisory_id": "GHSA-82w8-qh3p-5jfq",
      "aliases": [
        "CVE-2026-54283",
        "PYSEC-2026-249"
      ],
      "status": "NOT_AFFECTED",
      "justification": "Runtime accepts strict JSON carriers and never calls request.form().",
      "source_guards": [
        "request.form("
      ]
    },
    {
      "advisory_id": "GHSA-86qp-5c8j-p5mr",
      "aliases": [
        "CVE-2026-48710",
        "PYSEC-2026-161",
        "X41-2026-002"
      ],
      "status": "NOT_AFFECTED",
      "justification": "The only request.url.path reads select a sanitized validation-error envelope; routing, identity, authorization, scope, and resource lookup do not depend on reconstructed URL fields.",
      "source_guards": [
        "request.url.path:ERROR_ENVELOPE_ONLY"
      ]
    },
    {
      "advisory_id": "GHSA-jp82-jpqv-5vv3",
      "aliases": [
        "CVE-2026-54282",
        "PYSEC-2026-248"
      ],
      "status": "NOT_AFFECTED",
      "justification": "Runtime never uses request.url.hostname or request.url.netloc for trust, redirect, authorization, cache, or audit decisions.",
      "source_guards": [
        "request.url.hostname",
        "request.url.netloc"
      ]
    },
    {
