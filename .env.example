# Local/CI contract values only. Copy to an ignored .env and replace every
# replace-me value; this file is never loaded implicitly by the application.
PLANTNEXUS_SERVICE_NAME=plantnexus-aps
PLANTNEXUS_RUNTIME_ENVIRONMENT=development
PLANTNEXUS_DATA_PLANE=development
PLANTNEXUS_CODE_COMMIT=uncommitted
PLANTNEXUS_LOG_LEVEL=INFO
PLANTNEXUS_OTEL_TRACE_CONTEXT_ENABLED=true
PLANTNEXUS_SIMULATION_API_ENABLED=false
PLANTNEXUS_DATABASE_URL=postgresql+psycopg://plantnexus:replace-me-local-only@database:5432/plantnexus_dev
PLANTNEXUS_REDIS_URL=redis://redis:6379/0
PLANTNEXUS_CELERY_BROKER_URL=redis://redis:6379/1
PLANTNEXUS_CELERY_RESULT_BACKEND_URL=redis://redis:6379/2
PLANTNEXUS_READINESS_TIMEOUT_SECONDS=2
PLANTNEXUS_JOB_HEARTBEAT_SECONDS=30
PLANTNEXUS_JOB_LEASE_SECONDS=120

# Docker Compose interpolation only; this is a non-production placeholder.
PLANTNEXUS_POSTGRES_PASSWORD=replace-me-local-only
